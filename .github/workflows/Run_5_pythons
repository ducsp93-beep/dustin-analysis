name: Market Analysis

on:
  workflow_dispatch:          # manual: runs for 5 hours
  schedule:                   # all times UTC
    - cron: '0 1 * * *'       # window 01:00 -> 05:00
    - cron: '0 5 * * *'       # window 05:00 -> 10:00
    - cron: '0 10 * * *'      # window 10:00 -> 15:00

permissions:
  contents: read
  actions: read               # needed to see other running workflow runs

jobs:
  guard:
    runs-on: ubuntu-latest
    timeout-minutes: 5
    outputs:
      should_run: ${{ steps.g.outputs.should_run }}
      deadline: ${{ steps.g.outputs.deadline }}
    steps:
      - id: g
        env:
          GH_TOKEN: ${{ github.token }}
          REPO: ${{ github.repository }}
          RUN_ID: ${{ github.run_id }}
          EVENT: ${{ github.event_name }}
          SCHEDULE: ${{ github.event.schedule }}
        run: |
          NOW=$(date -u +%s)

          # ---- 1. Fixed deadline ----
          if [ "$EVENT" = "workflow_dispatch" ]; then
            DEADLINE=$(( NOW + 5*3600 ))                 # manual: now + 5h
          else
            case "$SCHEDULE" in
              '0 1 * * *')  END=05 ;;
              '0 5 * * *')  END=10 ;;
              '0 10 * * *') END=15 ;;
              *) echo "Unknown schedule: $SCHEDULE"; exit 1 ;;
            esac
            # absolute end of the window, regardless of when the job actually started
            DEADLINE=$(date -u -d "today ${END}:00:00" +%s)
          fi
          echo "deadline=$DEADLINE" >> "$GITHUB_OUTPUT"

          REMAINING=$(( DEADLINE - NOW ))
          echo "Remaining: ${REMAINING}s (deadline $(date -u -d @$DEADLINE))"

          # ---- 2. Scheduled runs: skip if the window is (almost) over ----
          if [ "$EVENT" = "schedule" ] && [ "$REMAINING" -lt 120 ]; then
            echo "Started too late for this window - skipping."
            echo "should_run=false" >> "$GITHUB_OUTPUT"; exit 0
          fi

          # ---- 3. Scheduled runs: skip if another run is already active ----
          if [ "$EVENT" = "schedule" ]; then
            WF_ID=$(gh api "repos/$REPO/actions/runs/$RUN_ID" --jq .workflow_id)
            OTHERS=0
            for STATUS in in_progress queued; do
              N=$(gh api "repos/$REPO/actions/workflows/$WF_ID/runs?status=$STATUS&per_page=100" \
                  --jq "[.workflow_runs[] | select(.id != $RUN_ID)] | length")
              OTHERS=$(( OTHERS + N ))
            done
            if [ "$OTHERS" -gt 0 ]; then
              echo "Another run is already active - skipping."
              echo "should_run=false" >> "$GITHUB_OUTPUT"; exit 0
            fi
          fi

          echo "should_run=true" >> "$GITHUB_OUTPUT"

  run:
    needs: guard
    if: needs.guard.outputs.should_run == 'true'
    runs-on: ubuntu-latest
    timeout-minutes: 345      # safety net only; the real limit is the deadline below
    steps:
      - uses: actions/checkout@v4

      - uses: actions/setup-python@v5
        with:
          python-version: '3.12'

      - name: Install dependencies
        run: |
          pip install websockets requests
          [ -f requirements.txt ] && pip install -r requirements.txt || true

      - name: Run all 5 scripts until the deadline
        env:
          DEADLINE: ${{ needs.guard.outputs.deadline }}
        run: |
          set +e
          # recompute AFTER setup so setup time is not added on top of the deadline
          REMAINING=$(( DEADLINE - $(date -u +%s) ))
          if [ "$REMAINING" -le 0 ]; then echo "Deadline already passed."; exit 0; fi
          echo "Running for ${REMAINING}s, until $(date -u -d @$DEADLINE)"

          pids=()
          for s in cash_flow_thick cash_flow_thin price_concentration price_continuity trade_count_12sec; do
            timeout --kill-after=20s "$REMAINING" python -u "$s.py" &
            pids+=($!)
          done

          FAIL=0
          for i in "${!pids[@]}"; do
            wait "${pids[$i]}"; rc=$?
            # 124 = stopped by the deadline (expected); 0 = exited cleanly
            if [ $rc -ne 0 ] && [ $rc -ne 124 ]; then
              echo "::error::script #$i exited with code $rc"; FAIL=1
            fi
          done
          exit $FAIL
